{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["esnext"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // Node runs server .ts files by stripping types. These two make tsc reject
    // anything that would type-check but break at runtime: non-erasable syntax
    // (enums, parameter properties, namespaces) and type imports missing `type`.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "*.config.ts"
  ]
}
